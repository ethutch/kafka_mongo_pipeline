# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPICS=customer-events,order-events
KAFKA_GROUP_ID=northwind-elt-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_ENABLE_AUTO_COMMIT=false
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=user
# KAFKA_SASL_PASSWORD=secret

# MongoDB
#MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://admin:passw0rd!@localhost:27017/?authSource=admin
MONGODB_DATABASE=northwind
MONGODB_COLLECTION=customers
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Application
LOG_LEVEL=INFO
BATCH_SIZE=100
BATCH_TIMEOUT_MS=50000
DEAD_LETTER_TOPIC=northwind-elt-events-dlq
SUPPORTED_CUSTOMER_EVENTS=4,9
SUPPORTED_ORDER_EVENTS=7
AWS_SERVICES=http://host.docker.internal:4566
